// Configuration niri utilisee par la session debug Kama Shell.
//
// La session `kama-shell-niri-debug-session` se place dans le tree source
// (cwd = APP_DIR), puis lance `niri --session --config config/niri/config.kdl`.
// niri herite du cwd: les commandes `spawn-at-startup` resolvent donc leurs
// chemins relativement a la racine du depot.
//
// Pour le packaging / les utilisateurs finaux, voir `config.kdl.example`.

// ---------------------------------------------------------------------------
// Lancement automatique
// ---------------------------------------------------------------------------
spawn-at-startup "/usr/bin/quickshell" "-p" "src/shell.qml"
spawn-at-startup "/usr/bin/xwayland-satellite"

include "binds.dev.kdl"

// ---------------------------------------------------------------------------
// Decoration des fenetres
// ---------------------------------------------------------------------------
prefer-no-csd

layout {
    focus-ring {
        on
    }

    border {
        on
        width 2
        active-color "#9bbcff"
        inactive-color "#3f4560"
        urgent-color "#ff5f6d"
    }

    struts {
        left 16
        right 16
        top 16
        bottom 16
    }
}

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

// ---------------------------------------------------------------------------
// Layer rules pour les namespaces Kama Shell.
// Le blur Liquid Glass est demande cote Quickshell avec `BackgroundEffect.blurRegion`.
// `xray false` force niri a flouter les fenetres derriere le shell au lieu de
// reutiliser seulement le wallpaper floute.
//
// Le Ring fournit sa propre region exacte via `RingBlurRegion`; ne pas ajouter
// `blur true` cote niri, sinon niri flouterait la geometrie de surface entiere.
// ---------------------------------------------------------------------------
layer-rule {
    match namespace="^kama-shell-launcher$"
    block-out-from "screencast"

    background-effect {
        xray false
    }
}

layer-rule {
    match namespace="^kama-shell-ring$"
    block-out-from "screencast"
    background-effect {
        xray false
    }
}

input {
	touchpad {
		natural-scroll
	}
}
