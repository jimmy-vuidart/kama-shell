// Configuration niri utilisee par la session debug Kama Shell.
//
// La session `kama-shell-niri-debug-session` se place dans le tree source
// (cwd = APP_DIR), puis lance `niri --session --config config/niri/config.kdl`.
// niri herite du cwd: les commandes `spawn-at-startup` resolvent donc leurs
// chemins relativement a la racine du depot.
//
// Pour le packaging / les utilisateurs finaux, voir `config.kdl.example`.

// ---------------------------------------------------------------------------
// Lancement automatique
// ---------------------------------------------------------------------------
spawn-at-startup "/usr/bin/quickshell" "-p" "src/shell.qml"
spawn-at-startup "/usr/bin/xwayland-satellite"
spawn-at-startup "/bin/sh" "-c" "command -v arch-update >/dev/null 2>&1 && exec arch-update --tray"

include "binds.dev.kdl"

// ---------------------------------------------------------------------------
// Decoration des fenetres
// ---------------------------------------------------------------------------
prefer-no-csd

hotkey-overlay {
   skip-at-startup
}

environment {
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    QT_QPA_PLATFORM "wayland"
    XDG_SESSION_TYPE "wayland"
    XDG_CURRENT_DESKTOP "niri"
    QT_QPA_PLATFORMTHEME "gtk3"
}

input {
    keyboard {
        xkb {
            layout "fr"
        }

        numlock
    }
	touchpad {
		natural-scroll
		tap
	}

	mouse {
		accel-profile "flat"
	}
}


layout {
    focus-ring {
        on
        width 2
        active-color "#9bbcff"
        inactive-color "#3f4560"
        urgent-color "#ff5f6d"
    }

    struts {
        left 28
        right 28
        top 28
        bottom 28
    }

    shadow {
        on
        softness 30
        spread 5
        color "#000000"
    }
}

window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

// Compatibilite avec d'eventuels menus natifs Qt ouverts par Quickshell.
// Le SystemTray de Kama Shell rend ses menus en QML via TrayMenuOverlay, mais
// cette regle garde les autres popups quickshell hors du tiling.
window-rule {
    match app-id="^quickshell$"
    open-floating true
}

// ---------------------------------------------------------------------------
// Output
// ---------------------------------------------------------------------------
include optional=true "~/.config/kama-shell/screen.kdl"

// ---------------------------------------------------------------------------
// Workspaces
// ---------------------------------------------------------------------------
include "workspace.kdl"

// ---------------------------------------------------------------------------
// Layer rules pour les namespaces Kama Shell.
// Le blur Liquid Glass est demande cote Quickshell avec `BackgroundEffect.blurRegion`.
// `xray false` force niri a flouter les fenetres derriere le shell au lieu de
// reutiliser seulement le wallpaper floute.
//
// Le Ring fournit sa propre region exacte via `RingBlurRegion`; ne pas ajouter
// `blur true` cote niri, sinon niri flouterait la geometrie de surface entiere.
// ---------------------------------------------------------------------------
layer-rule {
    match namespace="^kama-shell-settings$"
    block-out-from "screencast"

    background-effect {
        xray false
    }
}

layer-rule {
    match namespace="^kama-shell-launcher$"
    block-out-from "screencast"

    background-effect {
        xray false
    }
}

layer-rule {
    match namespace="^kama-shell-ring$"
    block-out-from "screencast"
    background-effect {
        xray false
    }
}

layer-rule {
    match namespace="^kama-shell-tray-menu$"
    block-out-from "screencast"

    background-effect {
        xray false
    }
}

layer-rule {
    match namespace="^kama-shell-session-actions$"
    block-out-from "screencast"

    background-effect {
        xray false
    }
}

layer-rule {
    match namespace="^kama-shell-osd$"

    background-effect {
        xray false
    }
}