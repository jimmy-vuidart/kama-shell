// Default niri binds for the Kama Shell source-tree debug session.
//
// config/niri/config.kdl includes this file with a relative path. The debug
// session starts niri with cwd = repository root, so src/shell.qml resolves
// against this tree.

binds {
    // Mouse resize is a built-in niri gesture: hold Mod + right-click and drag.
    // Do not bind Mod+MouseRight here; that would override the resize gesture.

    Mod+D repeat=false { spawn "/usr/bin/qs" "ipc" "--path" "src/shell.qml" "--any-display" "call" "kama-shell" "toggleLauncher"; }

    Mod+WheelScrollDown cooldown-ms=150 { focus-window-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-window-up; }

    Mod+Equal      { set-column-width "+10%"; }
    Mod+ParenRight { set-column-width "-10%"; }

    Mod+Q { close-window; }
    Mod+Return { spawn "kitty"; }

    Mod+Shift+E { quit; }

    Print           { screenshot; }
    Mod+Print       { screenshot-screen; }
    Mod+Shift+Print { screenshot-window; }
}
