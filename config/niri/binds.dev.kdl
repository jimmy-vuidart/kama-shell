// Default niri binds for the Kama Shell source-tree debug session.
//
// config/niri/config.kdl includes this file with a relative path. The debug
// session starts niri with cwd = repository root, so src/shell.qml resolves
// against this tree.

binds {
    // Mouse resize is a built-in niri gesture: hold Mod + right-click and drag.
    // Do not bind Mod+MouseRight here; that would override the resize gesture.

    Mod+D repeat=false { spawn "/usr/bin/qs" "ipc" "--path" "src/shell.qml" "--any-display" "call" "kama-shell" "toggleLauncher"; }
    Mod+Comma repeat=false { spawn "/usr/bin/qs" "ipc" "--path" "src/shell.qml" "--any-display" "call" "kama-shell" "toggleSettings"; }

    Mod+ScrollDown cooldown-ms=150 { focus-column-left; }
    Mod+ScrollUp   cooldown-ms=150 { focus-column-right; }

    Mod+Equal      { set-column-width "+10%"; }
    Mod+ParenRight { set-column-width "-10%"; }

    Mod+Q { close-window; }
    Mod+Return { spawn "kitty"; }

    Mod+Shift+E { quit; }

    Print           { screenshot; }
    Mod+Print       { screenshot-screen; }
    Mod+Shift+Print { screenshot-window; }

    XF86AudioRaiseVolume  allow-when-locked=true { spawn "sh" "-c" "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+ && wpctl set-mute @DEFAULT_AUDIO_SINK@ 0"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute         allow-when-locked=true { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }

    XF86MonBrightnessUp   allow-when-locked=true { spawn "/usr/bin/qs" "ipc" "--path" "src/shell.qml" "--any-display" "call" "kama-shell" "brightnessUp"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "/usr/bin/qs" "ipc" "--path" "src/shell.qml" "--any-display" "call" "kama-shell" "brightnessDown"; }
}
