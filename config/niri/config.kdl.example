// Exemple de configuration niri pour piloter Kama Shell.
//
// Installer ce fichier comme `~/.config/niri/config.kdl`, ou en l'incluant
// depuis votre configuration existante via la directive `include`.
//
// La session `kama-shell-niri.desktop` exporte:
//   - XDG_CURRENT_DESKTOP=KamaShell:niri
//   - KAMA_SESSION=1
//   - KAMA_COMPOSITOR=niri
//   - QT_QPA_PLATFORM=wayland
//
// Ces variables permettent a Kama Shell de se reperer dans son
// `CompositorState` singleton sans dependre des heuristiques d'environnement.
//
// Ne pas exporter `QT_WAYLAND_SHELL_INTEGRATION=layer-shell`: Quickshell
// embarque sa propre implementation wlr-layer-shell (cf. quickshell
// `src/wayland/wlr_layershell/`) et n'en a pas besoin. Exporter cette
// variable forcerait toutes les apps Qt (KeePassXC, Dolphin, ...) a creer
// leur fenetre principale comme surface layer-shell au lieu d'xdg-toplevel,
// ce qui les rend invisibles ou hors-tiling.

// ---------------------------------------------------------------------------
// Lancement automatique
//
// Kama Shell s'execute comme un client layer-shell autonome. Le binaire
// `/usr/bin/quickshell` (paquet `quickshell-git` sur Arch) lit `src/shell.qml`.
// Adapter les chemins si vos binaires ne sont pas sous `/usr/bin`:
//   - paquet AUR/Arch:   /usr/share/kama-shell/src/shell.qml
//   - clone developpeur: $HOME/Projets/kama-shell/src/shell.qml
// ---------------------------------------------------------------------------
spawn-at-startup "/usr/bin/quickshell" "-p" "/usr/share/kama-shell/src/shell.qml"

// xwayland-satellite expose les apps X11 a niri.
spawn-at-startup "/usr/bin/xwayland-satellite"

// Cachy-Update fournit un indicateur SystemTray si le paquet est installe.
spawn-at-startup "/bin/sh" "-c" "command -v arch-update >/dev/null 2>&1 && exec arch-update --tray"

// Si vous utilisez deja Waybar/Mako/etc., ne les lancez plus depuis niri:
// Kama Shell rend dock, launcher, ring et wallpaper. Une seule barre suffit.

// ---------------------------------------------------------------------------
// Raccourcis
//
// Les binds niri par defaut vivent dans un fichier separe. L'include est
// optionnel pour garder Kama Shell utilisable avec vos propres binds. Si vous
// copiez ce fichier depuis le depot au lieu du paquet, utilisez:
//   include optional=true "binds.kdl"
// ---------------------------------------------------------------------------
include optional=true "/usr/share/doc/kama-shell/niri-binds.kdl"

// ---------------------------------------------------------------------------
// Decoration des fenetres
//
// `prefer-no-csd` demande aux apps compatibles de laisser niri dessiner les
// decorations. Les apps qui gardent leurs CSD peuvent ignorer cette demande.
// ---------------------------------------------------------------------------
prefer-no-csd

layout {
    focus-ring {
        off
    }

    border {
        on
        width 2
        active-color "#9bbcff"
        inactive-color "#3f4560"
        urgent-color "#ff5f6d"
    }

    struts {
        left 16
        right 16
        top 16
        bottom 16
    }
}

// Arrondit les fenetres et clippe leur contenu pour eviter les coins carres.
window-rule {
    geometry-corner-radius 12
    clip-to-geometry true
}

// Compatibilite avec d'eventuels menus natifs Qt ouverts par Quickshell.
// Le SystemTray de Kama Shell rend ses menus en QML via TrayMenuOverlay, mais
// cette regle garde les autres popups quickshell hors du tiling.
window-rule {
    match app-id="^quickshell$"
    open-floating true
}

// ---------------------------------------------------------------------------
// Layer rules
//
// Les namespaces sont definis dans:
//   - components/Ring.qml              -> kama-shell-ring
//   - components/AppLauncherOverlay.qml -> kama-shell-launcher
//   - components/WallpaperWindow.qml    -> kama-shell-wallpaper
//   - components/TrayMenuOverlay.qml    -> kama-shell-tray-menu
//   - components/SessionActionsOverlay.qml -> kama-shell-session-actions
//   - components/OsdOverlay.qml         -> kama-shell-osd
//   - components/SettingsOverlay.qml    -> kama-shell-settings
//
// Kama Shell demande le blur Liquid Glass lui-meme via `BackgroundEffect.blurRegion`
// sur des regions bornees et exactes. `xray false` demande a niri de flouter les
// fenetres derriere les panneaux au lieu de reutiliser seulement le wallpaper
// floute. Ne pas ajouter `blur true` ici: la region de blur vient de Quickshell.
//
// Le Ring fournit sa propre region exacte via `RingBlurRegion`; ne pas ajouter
// `blur true` cote niri, sinon niri flouterait la geometrie de surface entiere.
// ---------------------------------------------------------------------------
layer-rule {
    match namespace="^kama-shell-settings$"
    block-out-from "screencast"

    background-effect {
        xray false
    }
}

layer-rule {
    match namespace="^kama-shell-launcher$"
    block-out-from "screencast"

    background-effect {
        xray false
    }
}

layer-rule {
    match namespace="^kama-shell-ring$"
    block-out-from "screencast"

    background-effect {
        xray false
    }
}

layer-rule {
    match namespace="^kama-shell-tray-menu$"
    block-out-from "screencast"

    background-effect {
        xray false
    }
}

layer-rule {
    match namespace="^kama-shell-session-actions$"
    block-out-from "screencast"

    background-effect {
        xray false
    }
}

layer-rule {
    match namespace="^kama-shell-osd$"

    background-effect {
        xray false
    }
}

// ---------------------------------------------------------------------------
// Input
// ---------------------------------------------------------------------------
input {
	touchpad {
		natural-scroll
		tap
	}

	mouse {
		accel-profile flat
	}
}

// ---------------------------------------------------------------------------
// Sortie
// ---------------------------------------------------------------------------
// Inclure la configuration d'ecran specifique a la machine. Ce fichier peut
// contenir des blocs output定 desperso.
include optional=true "~/.config/kama-shell/screen.kdl"
//
// Adapter ces blocs selon votre materiel.
// ---------------------------------------------------------------------------
// output "DP-1" {
//     mode "2560x1440@165"
//     scale 1
// }

// ---------------------------------------------------------------------------
// Services desktop minimaux
//
// niri ne fournit pas:
//   - de daemon de notification: utilisez `mako`, `dunst`, `swaync`...
//   - d'agent polkit: utilisez `polkit-gnome` ou `polkit-kde-agent`.
//   - de portails xdg-desktop-portal: installez `xdg-desktop-portal-gnome`
//     ou `xdg-desktop-portal-wlr` selon vos besoins (screencast, file-picker).
//   - d'idle/lock natif: combinez `swayidle` et `swaylock`.
//
// Pour les services persistants, preferer un unit systemd `--user` rattache
// a `graphical-session.target` plutot que `spawn-at-startup`. niri pousse
// `niri.service` dans la cible quand il est lance via `niri-session`.
//
// Pre-requis recommandes:
//   - niri                  (compositeur Wayland)
//   - quickshell-git        (binaire `quickshell` / `qs`)
//   - layer-shell-qt        (plugin Qt `layer-shell` pour PanelWindow)
//   - xwayland-satellite    (apps X11)
//   - xdg-desktop-portal-gnome ou -wlr (portails)
//   - polkit-gnome ou polkit-kde-agent (auth)
//   - mako ou autre notification daemon
// ---------------------------------------------------------------------------
